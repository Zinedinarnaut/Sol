#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D source_texture;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D destination_texture;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dimensions = imageSize(destination_texture);
    if (pixel.x >= dimensions.x || pixel.y >= dimensions.y)
    {
        return;
    }

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(dimensions);
    imageStore(destination_texture, pixel, texture(source_texture, uv));
}
