<?xml version="1.0" encoding="utf-8"?>
<!--
  Root NuGet configuration.

  The pre-release Ryujinx.LibHac alpha (pulled in transitively via Gommon) only
  lives on the LibHacAlpha feed, which Vendor/Ryubing/nuget.config already adds.
  But NuGet walks up from the project directory, and NativeHost/Sol.Engine sits
  outside Vendor/Ryubing, so it never sees that feed and the restore fails with
  NU1102. Declaring the feed here makes it visible to every project.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="LibHacAlpha" value="https://git.ryujinx.app/api/packages/projects/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="LibHacAlpha">
      <package pattern="Ryujinx.LibHac" />
    </packageSource>
  </packageSourceMapping>
</configuration>
