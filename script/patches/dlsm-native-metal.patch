+        internal void CollectBoundTextureStorages(HashSet<TextureStorage> storages)
+        {
+            if (_program == null)
+            {
+                return;
+            }
+
+            if (_program.BindingSegments.Length > PipelineBase.TextureSetIndex)
+            {
+                foreach (ResourceBindingSegment segment in _program.BindingSegments[PipelineBase.TextureSetIndex])
+                {
+                    if (segment.IsArray)
+                    {
+                        if ((uint)segment.Binding < _textureArrayRefs.Length)
+                        {
+                            _textureArrayRefs[segment.Binding].Array?.CollectStorages(storages);
+                        }
+                    }
+                    else if (segment.Type != ResourceType.BufferTexture)
+                    {
+                        int end = Math.Min(_textureRefs.Length, segment.Binding + segment.Count);
+                        for (int binding = segment.Binding; binding < end; binding++)
+                        {
+                            TextureStorage storage = _textureRefs[binding].View?.Storage;
+                            if (storage != null)
+                            {
+                                storages.Add(storage);
+                            }
+                        }
+                    }
+                }
+            }
+
+            if (_program.BindingSegments.Length > PipelineBase.ImageSetIndex)
+            {
+                foreach (ResourceBindingSegment segment in _program.BindingSegments[PipelineBase.ImageSetIndex])
+                {
+                    if (segment.IsArray)
+                    {
+                        if ((uint)segment.Binding < _imageArrayRefs.Length)
+                        {
+                            _imageArrayRefs[segment.Binding].Array?.CollectStorages(storages);
+                        }
+                    }
+                    else if (segment.Type != ResourceType.BufferImage)
+                    {
+                        int end = Math.Min(_imageRefs.Length, segment.Binding + segment.Count);
+                        for (int binding = segment.Binding; binding < end; binding++)
+                        {
+                            TextureStorage storage = _imageRefs[binding].View?.Storage;
+                            if (storage != null)
+                            {
+                                storages.Add(storage);
+                            }
+                        }
+                    }
+                }
+            }
+
+            for (int setIndex = PipelineBase.DescriptorSetLayouts;
+                 setIndex < _program.BindingSegments.Length;
+                 setIndex++)
+            {
+                ResourceBindingSegment[] segments = _program.BindingSegments[setIndex];
+                if (segments.Length == 0 || !segments[0].IsArray)
+                {
+                    continue;
+                }
+
+                int extraIndex = setIndex - PipelineBase.DescriptorSetLayouts;
+                ResourceType type = segments[0].Type;
+
+                if (type is ResourceType.Texture or
+                    ResourceType.Sampler or
+                    ResourceType.TextureAndSampler or
+                    ResourceType.BufferTexture)
+                {
+                    if ((uint)extraIndex < _textureArrayExtraRefs.Length)
+                    {
+                        _textureArrayExtraRefs[extraIndex].Array?.CollectStorages(storages);
+                    }
+                }
+                else if (type is ResourceType.Image or ResourceType.BufferImage)
+                {
+                    if ((uint)extraIndex < _imageArrayExtraRefs.Length)
+                    {
+                        _imageArrayExtraRefs[extraIndex].Array?.CollectStorages(storages);
+                    }
+                }
+            }
+        }
